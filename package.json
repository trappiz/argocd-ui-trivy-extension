{
  "name": "argocd-trivy-extension",
  "version": "0.1.0",
  "description": "Argo CD UI extension that shows trivy-operator security reports next to your workloads",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trappiz/argocd-ui-trivy-extension.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --serve",
    "package": "node build.mjs && tar -C dist -cf dist/extension-trivy.tar resources",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
